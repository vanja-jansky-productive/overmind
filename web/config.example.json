{
  "version": 1,
  "self": "laptop",
  "defaultHost": "workstation",
  "hosts": {
    "laptop": { "ssh": null, "web": "http://100.x.y.z:7878" },
    "workstation": { "ssh": "workstation", "web": "http://100.x.y.z:7878" }
  },
  "web": {
    "port": 7878,
    "bind": "0.0.0.0",
    "dir": null,
    "ui": null,
    "editor": "vscode",
    "quickReplies": ["Continue.", "Yes", "No", "1", "2"],
    "models": [
      { "id": "", "label": "Default" },
      { "id": "opus", "label": "Opus (newest)" },
      { "id": "claude-opus-5-5[1m]", "label": "Opus 5.5 1M" }
    ],
    "autoName": { "enabled": true, "intervalMinutes": 5 },
    "grouping": { "enabled": true, "intervalMinutes": 10 },
    "briefs": { "enabled": false, "model": "haiku", "idleMs": 60000, "minIntervalMs": 900000, "maxDeltaChars": 12000, "maxCallsPerHour": 12 },
    "uploads": { "dir": "~/.local/share/overmind/uploads", "maxMB": 100, "retentionDays": 14 },
    "files": { "roots": [] },
    "memos": { "dir": "~/Code/notes/memos", "audioDir": "~/.local/share/overmind/memo-audio", "model": "haiku", "vocabulary": ["Claude", "overmind", "PR"] },
    "notes": { "root": "~/Code/notes", "name": "Notes", "searchCmd": null, "exclude": ["drafts"] },
    "discovery": { "watch": true, "safetySeconds": 30, "fastGapMs": 1000, "slowGapMs": 5000 }
  },
  "grouping": { "enabled": true, "model": "haiku", "host": "workstation" },
  "tmux": null,
  "overmindBin": null,
  "spawnDirs": [
    { "label": "Work", "paths": { "laptop": "~/Code/project", "workstation": "~/Code/project" } },
    { "label": "Notes", "paths": { "workstation": "~/Code/notes" } }
  ]
}
